generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

generator json {
  provider = "prisma-json-types-generator"
}

enum UserRole {
  user
  admin
}

enum OAuthProvider {
    google
    naver
    kakao
    apple
}

enum FriendshipStatus {
    pending
    accepted
    declined
    removed
}

enum RoomVisibility {
    public
    private
    invite
}

enum RoomStatus {
    active
    closed
    archived
}

enum RoomMemberRole {
    member
    moderator
    owner
}

enum RoomMessageType {
    text
    recommendation
    saved_card
    lyric_quote
    system
}

enum DmStatus {
    pending
    open
    declined
}

enum ReportTargetType {
    comment
    room_message
    recommendation
}

enum ReportStatus {
    pending
    resolved
    dismissed
}

enum AdminStatsMetric {
    recommendations
    signups
    active
}

enum NotificationType {
    comment_reply
}

enum AlbumVisibility {
    private
    public
}




model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  nickname     String   @unique
  passwordHash String?
  role         UserRole @default(user)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  bio          String?
  albumVisibility AlbumVisibility @default(private)
  lastActiveAt DateTime? @db.Timestamptz(3)
  image String?
  deletedAt DateTime? @db.Timestamptz(3)
  withdrawScheduledAt DateTime? @db.Timestamptz(3)

  dmMembers DmMember[]
  dmMessages DmMessage[]
  dmRequestsSent Dm[] @relation("DmRequestedBy")

  recommendations Recommendation[]
  reactions      Reaction[]
  savedCards SavedCard[]
  comments Comment[]
  oauthAccounts OAuthAccount[]

  sentFriendRequests Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
  blocksOutgoing         Block[]      @relation("BlockBlocker")
  blocksIncoming         Block[]      @relation("BlockBlocked")
  savedLyrics SavedLyric[]

  ownedRooms Room[] @relation("RoomOwner")
  roomMembers RoomMember[]
  roomMessages RoomMessage[]

  roomBans RoomBan[] @relation("RoomBanUser")
  roomBansIssued RoomBan[] @relation("RoomBanKicker")

  notices Notice[]

  roomChatThemes RoomChatTheme[]

  messageHides RoomMessageHide[]
  messageReactions RoomMessageReaction[]
  messagesDeleted RoomMessage[] @relation("RoomMessageDeletedBy")

  reports Report[]

  notifications Notification[]
  notificationsSent Notification[] @relation("NotificationActor")

  @@index([deletedAt])
  @@index([withdrawScheduledAt])
}

model Notice {
    id String @id @default(uuid(7)) @db.Uuid
    title String
    body String
    published Boolean @default(false) 
    publishedAt DateTime? @db.Timestamptz(3)
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)
    authorId String @db.Uuid
    author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

    @@index([published,publishedAt(sort:Desc)])
}




model OAuthAccount {
    id String @id @default(uuid(7)) @db.Uuid
    provider OAuthProvider
    providerAccountId String
    userId String @db.Uuid
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now()) @db.Timestamptz(3)

    @@unique([provider,providerAccountId])
    @@index([provider])
}

model Recommendation {
  id        String   @id @default(uuid(7)) @db.Uuid
  title     String
  artist    String
  embedUrl  String
  reason    String
  moods     String[]
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  authorId  String   @db.Uuid
  author    User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  savedCards SavedCard[]
  reactions Reaction[]
  comments Comment[]
  roomMessages RoomMessage[]

  savedLyrics SavedLyric[]

  @@index([authorId])
}

model Reaction {
  id               String   @id @default(uuid(7)) @db.Uuid
  recommendationId String   @db.Uuid
  type             String   @default("like")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, userId])
  @@index([recommendationId])
  @@index([userId])
}

model SavedCard{
  id String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  recommendationId String @db.Uuid
  customization Json /// [SavedCardCustomization]
  shelfRank Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationId])
  @@index([userId])
  @@index([userId,shelfRank])
}

model Comment {
    id String @id @default(uuid(7)) @db.Uuid
    recommendationId String @db.Uuid
    authorId String @db.Uuid
    body String
    parentId String? @db.Uuid
    deletedAt DateTime? @db.Timestamptz(3)
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
    author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
    parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
    replies Comment[] @relation("CommentReplies")

    @@index([recommendationId])
    @@index([authorId])
    @@index([parentId])
}

model Friendship {
    id String @id @default(uuid(7)) @db.Uuid
    requesterId String @db.Uuid
    addresseeId String @db.Uuid
    status FriendshipStatus @default(pending)
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    respondedAt DateTime? @db.Timestamptz(3)

    requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
    addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

    @@unique([requesterId, addresseeId])
    @@index([requesterId,status])
    @@index([addresseeId,status])
}

model Block {
    id String @id @default(uuid(7)) @db.Uuid
    blockerId String @db.Uuid
    blockedId String @db.Uuid
    createdAt DateTime @default(now()) @db.Timestamptz(3)

    blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
    blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

    @@unique([blockerId, blockedId])
    @@index([blockedId])
}

model Room {
    id String @id @default(uuid(7)) @db.Uuid
    name String
    ownerId String @db.Uuid
    description String?
    topicTags String[] @default([])
    visibility RoomVisibility @default(public)
    status RoomStatus @default(active)
    memberCount Int @default(1)
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    passwordHash String?
    passwordHint String?


    owner User @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
    members RoomMember[]
    messages RoomMessage[]

    bans RoomBan[]
    chatThemes RoomChatTheme[]


    @@index([status,visibility])
    @@index([ownerId])
}   



model RoomMember {
  id         String         @id @default(uuid(7)) @db.Uuid
  roomId     String         @db.Uuid
  userId     String         @db.Uuid
  role       RoomMemberRole @default(member)
  mutedUntil DateTime?      @db.Timestamptz(3)
  joinedAt   DateTime       @default(now()) @db.Timestamptz(3)
  lastReadAt DateTime       @default(now()) @db.Timestamptz(3)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([roomId, userId])
  @@index([userId])
}

model RoomMessage {
  id               String          @id @default(uuid(7)) @db.Uuid
  roomId           String          @db.Uuid
  senderId         String          @db.Uuid
  type             RoomMessageType @default(text)
  body             String?
  recommendationId String?         @db.Uuid
  savedCardId      String?         @db.Uuid
  lyricStartSec Int?
  lyricEndSec  Int?
  replyToId      String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  deletedAt        DateTime?       @db.Timestamptz(3)
  deletedByOwner Boolean @default(false)
  deletedById String? @db.Uuid

  deletedBy      User?    @relation("RoomMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender         User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  hides RoomMessageHide[]
  reactions RoomMessageReaction[]
  replyTo        RoomMessage?     @relation("RoomMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        RoomMessage[]    @relation("RoomMessageReplies")

  @@index([roomId, createdAt])
  @@index([senderId])
  @@index([recommendationId])
  @@index([savedCardId])
  @@index([replyToId])
  @@index([deletedById])
}

model RoomMessageReaction{
    id String @id @default(uuid(7)) @db.Uuid
    messageId String @db.Uuid
    userId String @db.Uuid
    emoji String
    createdAt DateTime @default(now()) @db.Timestamptz(3)

    message RoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    /// 같은 유저가 여러 이모지 OK · 같은 이모지 다시 누르면 취소
    @@unique([messageId, userId, emoji])
    @@index([userId])
    @@index([messageId])
}


model RoomBan {
    id String @id @default(uuid(7)) @db.Uuid
    roomId String @db.Uuid
    userId String @db.Uuid
    kickedBy String @db.Uuid
    createdAt DateTime @default(now()) @db.Timestamptz(3)

    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
    user User @relation("RoomBanUser", fields: [userId], references: [id], onDelete: Cascade)
    kicker User @relation("RoomBanKicker", fields: [kickedBy], references: [id], onDelete: Cascade)

    @@unique([roomId, userId])
    @@index([userId])
}

model RoomChatTheme {
    id String @id @default(uuid(7)) @db.Uuid
    userId String @db.Uuid
    roomId String @db.Uuid
    presetId String  @default("lp-bar")
    backgroundUrl String?
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

    @@unique([userId, roomId])
    @@index([roomId])
}

model SavedLyric{
    id String @id @default(uuid(7)) @db.Uuid
    userId String @db.Uuid
    recommendationId String @db.Uuid
    lyricsText String
    note String?
    startSec Int?
    endSec Int?
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([recommendationId])
}


model RoomMessageHide {
    id String @id @default(uuid(7)) @db.Uuid
    messageId String @db.Uuid
    userId String @db.Uuid
    createdAt DateTime @default(now()) @db.Timestamptz(3)

    message RoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([messageId, userId])
    @@index([userId])
}

model Dm{
    id String @id @default(uuid(7)) @db.Uuid
    pairKey String @unique
    status DmStatus @default(open)
    requestedById String? @db.Uuid
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    requestedBy User? @relation("DmRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
    members DmMember[]
    messages DmMessage[]

    @@index([status])
    @@index([requestedById])
}

model DmMember {
    id String @id @default(uuid(7)) @db.Uuid
    dmId String @db.Uuid
    userId String @db.Uuid
    lastReadAt DateTime @default(now()) @db.Timestamptz(3)
    joinedAt DateTime @default(now()) @db.Timestamptz(3)

    dm Dm @relation(fields: [dmId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([dmId, userId])
    @@index([userId])
}

model DmMessage {
    id String @id @default(uuid(7)) @db.Uuid
    dmId String @db.Uuid
    senderId String @db.Uuid
    body String
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    dm Dm @relation(fields: [dmId], references: [id], onDelete: Cascade)
    sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

    @@index([dmId,createdAt])
    @@index([senderId])
}

model Report {
    id String @id @default(uuid(7)) @db.Uuid
    targetType ReportTargetType
    targetId String @db.Uuid
    reporterId String @db.Uuid
    reason String
    status ReportStatus @default(pending)
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

    @@index([reporterId,targetType,targetId])
    @@index([status,createdAt])
    @@index([targetType,targetId])
    @@index([reporterId])
}

model AdminStatsDailySnapshot {
  id        String           @id @default(uuid(7)) @db.Uuid
  date      DateTime         @db.Date
  /// -1 = 일 합계 · 0~23 = KST 시간대 (null 금지 — unique 안전)
  hour      Int
  metric    AdminStatsMetric
  count     Int
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([date, hour, metric])
  @@index([metric, date])
}

model Notification {
    id String @id @default(uuid(7)) @db.Uuid
    userId String @db.Uuid
    type NotificationType
    recommendationId String @db.Uuid
    commentId String @db.Uuid
    actorId String @db.Uuid
    readAt DateTime? @db.Timestamptz(3)
    createdAt DateTime @default(now()) @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

    @@index([userId,createdAt(sort:Desc)])
    @@index([userId,readAt])
}